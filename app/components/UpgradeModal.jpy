---
from hyperflask import request
from hyperflask_users import current_user, login_required
from app.models import db, Database

@login_required
def get():
    pass
---
<{Modal close_btn=True width="w-11/12 max-w-6xl" responsive=False}>
    <{ModalTitle}>Upgrade now ! <span class="badge badge-warning">Exclusive launch offers!</span></{}>
    <div class="flex">
        <div class="flex flex-col m-4 rounded-xl shadow-xl p-4 border border-gray-100 w-1/3">
            <h2 class="font-fold text-center text-lg">Discover</h2>
            <div class="flex justify-center items-center h-24 font-bold text-2xl">
                Free
            </div>
            <p class="grow my-4">
                Discover SQLETL and try it yourself
            </p>
            <ul class="list-disc px-4 mb-4">
                <li>50 free queries per month</li>
                <li>Unlimited databases</li>
                <li>Unlimited integrations</li>
                <li>1 Mo data transfer per query</li>
            </ul>
            <{LinkButton class="btn-primary" href=url_for('subscription', plan='free') disabled=(current_user.plan=='free')}>Select</{}>
        </div>
        <div class="flex flex-col m-4 rounded-xl shadow-xl p-4 border border-gray-100 w-1/3">
            <h2 class="font-fold text-center text-lg">Standard</h2>
            <div class="flex flex-col justify-center items-center h-24 font-bold text-2xl">
                <div class="text-sm text-gray-400 line-through font-normal">39€ / month</div>
                59€ / year
            </div>
            <p class="grow my-4">
                Combine all your apps and APIs into a single database
                and unleash your data without the complexity of a datawarehouse.
            </p>
            <ul class="list-disc px-4 mb-4">
                <li><strong>Unlimited queries</strong></li>
                <li>Unlimited databases</li>
                <li>Unlimited integrations</li>
                <li>10 Mo data transfer per query</li>
            </ul>
            <{LinkButton class="btn-primary" href=url_for('subscription', plan='standard') disabled=(current_user.plan=='standard')}>Select</{}>
        </div>
        <div class="flex flex-col m-4 rounded-xl shadow-xl p-4 border border-gray-100 w-1/3">
            <h2 class="font-fold text-center text-lg">Premium</h2>
            <div class="flex flex-col justify-center items-center h-24 font-bold text-2xl">
                <div class="text-sm text-gray-400 line-through font-normal">69€ / month</div>
                99€ / year
                <div class="badge badge-info mt-4">Popular amongst data analysts</div>
            </div>
            <p class="grow my-4">
                Use any PostgreSQL compatible client like PowerBI and Jupyter Notebooks with SQLify.
            </p>
            <ul class="list-disc px-4 mb-4">
                <li>Everything included in Standard</li>
                <li><strong>Access SQLify from any PostgreSQL client</strong></li>
                <li>100 Mo data transfer per query</li>
            </ul>
            <{LinkButton class="btn-primary" href=url_for('subscription', plan='premium') disabled=(current_user.plan=='premium')}>Select</{}>
        </div>
    </div>
</{}>
